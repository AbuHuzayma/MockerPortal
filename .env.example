# Copy to .env and adjust for local development. Never commit the real .env file.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_dev_password
POSTGRES_PORT=5432

# --- Backend (Portal.Api) secrets — set as real environment variables, never in appsettings.*.json ---
# Local dev: ConnectionStrings:PortalDb already defaults to the docker-compose
# Postgres above in appsettings.Development.json, so this is only needed to
# override it (or is required for QA/PREPROD, where there is no default).
# ConnectionStrings__PortalDb=Host=localhost;Port=5432;Database=portal;Username=portal;Password=portal_dev_password
#
# Local dev: if unset, the API generates an ephemeral signing key at startup
# (logged as a warning) — fine for a quick `dotnet run`, but refresh tokens
# won't survive a restart. Set this for a stable local session, and it is
# REQUIRED (the API refuses to start without it) outside Development.
# Jwt__SigningKey=replace-with-a-long-random-local-dev-only-secret
#
# Only required when Providers:Customer:Mode=Sql (QA/PREPROD; local DEV stays
# on MockCustomerProvider by default and never needs this). Also used by
# Kyc/Creation/Security-lock providers in "Sql" mode — same database.
# ConnectionStrings__CustomerDatabase=Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True
#
# Only required when Providers:Merchant:Mode=Sql (QA/PREPROD).
# ConnectionStrings__MerchantDatabase=Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True
#
# Only required when Providers:CardManagement:Mode / BeneficiaryService:Mode /
# B2BService:Mode is "Real" (docs/08 §4 — assumed contracts, real base URLs
# unknown until the actual API specs are supplied).
# Integrations__CardManagement__BaseUrl=https://card-management.internal.example
# Integrations__BeneficiaryService__BaseUrl=https://beneficiary-service.internal.example
# Integrations__B2BService__BaseUrl=https://b2b-matrix.internal.example

# --- Frontend (portal-ui) ---
# VITE_API_BASE_URL=/api/v1
